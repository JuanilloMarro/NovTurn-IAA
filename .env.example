# Copiar a `.env.local` y rellenar. `.env.local` no se sube al repositorio.
VITE_SUPABASE_URL=https://<ref-del-proyecto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Con `true` se habilita la RPC `identificar_usuario`, que confirma si un correo
# existe. Es enumeración de usuarios y la práctica la exige; en producción va en
# `false`. Ver PLAN.md §3.4.
VITE_MODO_DEMO=true
